# ── OpenRouter (NVIDIA Nemotron) ───────────────────────────────────────────────
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL_NAME="nvidia/nemotron-3.5-lightning:free"

# ── YouTube OAuth ──────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID="your_client_id"
YOUTUBE_CLIENT_SECRET="your_client_secret"
YOUTUBE_PROJECT_ID="your_project_id"
YOUTUBE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
YOUTUBE_TOKEN_URI="https://oauth2.googleapis.com/token"
YOUTUBE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
YOUTUBE_REDIRECT_URI="http://localhost"

# ── Optional: enable Pollinations still-image backgrounds ─────────────────────
# When true, scenes with kind=image use Pollinations.ai for still backgrounds.
# Default: true (set by the project to allow optional Pollinations stills).
USE_POLLINATIONS_STILL=true

HF_TTS_MODEL="hexgrad/Kokoro-82M"
HF_API_TOKEN="YOUR HUGGING FACE TOKEN"  